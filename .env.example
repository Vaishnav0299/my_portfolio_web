# Web3Forms API Access Key (Obtain from https://web3forms.com)
VITE_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# ─── API (apps/api) ───────────────────────────────────────────────────────────
# Supabase PostgreSQL connection string
# Find in: Supabase Dashboard → Project Settings → Database → Connection string (URI mode)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# JWT signing secret — use a strong random string (e.g. openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_here

# Admin login credentials
ADMIN_EMAIL=admin@portfolio.dev
ADMIN_PASSWORD_HASH=your_bcrypt_hash_here

# ─── Frontend (apps/web) ──────────────────────────────────────────────────────
# API base URL — use relative path for same-domain Vercel deployment
# For local dev: http://localhost:3001
VITE_API_URL=/api
