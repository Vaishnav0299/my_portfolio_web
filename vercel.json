{
  "buildCommand": "pnpm --filter portfolio-frontend build",
  "outputDirectory": "portfolio-frontend/dist",
  "installCommand": "npm install -g pnpm && pnpm install --no-frozen-lockfile",
  "functions": {
    "api/index.ts": {
      "includeFiles": "portfolio-backend/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/(.*)",     "destination": "/index.html" }
  ]
}
